---
- name: add-apt-repository
  repo: ppa:revysr/noble-eic770x
- name: cp
  source: {{PWD}}/flash-kernel/machine
  dest: $LAYERS[0]/etc/flash-kernel/machine
- name: cp
  source: {{PWD}}/flash-kernel/db
  dest: $LAYERS[0]/etc/flash-kernel/db
- name: cp
  source: {{PWD}}/grub/10_cmdline.cfg
  dest: $LAYERS[0]/etc/default/grub.d/10_cmdline.cfg
- name: cp
  source: {{PWD}}/grub/90_watchdog-thresh.cfg
  dest: $LAYERS[0]/etc/default/grub.d/90_watchdog-thresh.cfg
- name: replace-kernel
  flavor: eic7700x
